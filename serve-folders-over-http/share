#!/usr/bin/env python3
"""Serve local folders over HTTP, each behind its own unguessable URL."""

import argparse
import json
import re
import secrets
import shutil
import subprocess
import sys
from datetime import date, datetime
from pathlib import Path

import yaml
from jinja2 import Environment, FileSystemLoader, StrictUndefined

ROOT = Path(__file__).resolve().parent
REGISTRY = ROOT / "shares.json"
ENDPOINTS = ROOT / "endpoints.txt"
COMPOSE = ROOT / "docker-compose.yml"
CONF_DIR = ROOT / "nginx" / "conf.d"
NGINX_CONF = CONF_DIR / "shares.conf"
TEMPLATES = ROOT / "templates"
ENV_FILE = ROOT / ".env"

GENERATED = "Generated by ./share. Edits are overwritten."
NAME_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}$")

DEFAULTS = {
    "BIND_ADDR": "0.0.0.0",
    "PORT": "8080",
    "PUBLIC_HOST": "",
    "NGINX_IMAGE": "nginx:1.27-alpine",
    "PROJECT_NAME": "serve-folders-over-http",
}


def die(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def load_config():
    config = dict(DEFAULTS)
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.removeprefix("export ").partition("=")
            config[key.strip()] = value.strip().strip("\"'")

    if not config["PORT"].isdigit():
        die(f"PORT must be a number, got {config['PORT']!r}")
    if not config["PUBLIC_HOST"]:
        config["PUBLIC_HOST"] = f"http://localhost:{config['PORT']}"
    config["PUBLIC_HOST"] = config["PUBLIC_HOST"].rstrip("/")
    return config


def load_shares():
    if not REGISTRY.exists():
        return []
    try:
        return json.loads(REGISTRY.read_text())
    except json.JSONDecodeError as exc:
        die(f"{REGISTRY.name} is not valid JSON: {exc}")


def save_shares(shares):
    REGISTRY.write_text(json.dumps(shares, indent=2) + "\n")


def find_share(shares, key):
    for share in shares:
        if key in (share["name"], share["slug"]):
            return share
    die(f"no share named {key!r} — run ./share list")


def make_name(raw):
    name = re.sub(r"[^a-z0-9._-]+", "-", raw.lower()).strip("-.")
    return name[:64] or "share"


def make_slug(shares):
    taken = {share["slug"] for share in shares}
    while True:
        slug = secrets.token_hex(12)
        if slug not in taken:
            return slug


def share_url(config, share):
    return f"{config['PUBLIC_HOST']}/{share['slug']}/"


def write_compose(config, shares):
    volumes = [f"./{CONF_DIR.relative_to(ROOT)}:/etc/nginx/conf.d:ro"]
    volumes += [f"{share['path']}:/srv/{share['name']}:ro" for share in shares]

    compose = {
        "name": config["PROJECT_NAME"],
        "services": {
            "nginx": {
                "image": config["NGINX_IMAGE"],
                "container_name": f"{config['PROJECT_NAME']}-nginx",
                "restart": "unless-stopped",
                "ports": [f"{config['BIND_ADDR']}:{config['PORT']}:80"],
                "volumes": volumes,
            }
        },
    }

    body = yaml.safe_dump(compose, sort_keys=False, default_flow_style=False, width=10_000)
    COMPOSE.write_text(f"# {GENERATED}\n{body}")


def write_nginx_conf(shares):
    env = Environment(
        loader=FileSystemLoader(TEMPLATES),
        undefined=StrictUndefined,
        keep_trailing_newline=True,
        trim_blocks=True,
        lstrip_blocks=True,
    )
    rendered = env.get_template("nginx.conf.j2").render(shares=shares, generated=GENERATED)
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    NGINX_CONF.write_text(rendered)


def write_endpoints(config, shares):
    lines = [
        f"# {GENERATED}",
        f"# Updated {datetime.now().strftime('%Y-%m-%d %H:%M')}",
        "",
    ]
    if not shares:
        lines.append("No folders are being served.")
    else:
        width = max(len(share["name"]) for share in shares)
        url_width = max(len(share_url(config, share)) for share in shares)
        for share in sorted(shares, key=lambda s: s["name"]):
            url = share_url(config, share)
            lines.append(
                f"{share['name']:<{width}}  {url:<{url_width}}  {share['path']}  (added {share['added']})"
            )
    ENDPOINTS.write_text("\n".join(lines) + "\n")


def compose_cmd(*args):
    if not shutil.which("docker"):
        die("docker is not installed or not on PATH")
    result = subprocess.run(["docker", "compose", "-f", str(COMPOSE), *args])
    if result.returncode != 0:
        die(f"docker compose {' '.join(args)} failed")


def apply(config, shares, quiet=False):
    write_compose(config, shares)
    write_nginx_conf(shares)
    write_endpoints(config, shares)

    compose_cmd("down", "--remove-orphans")
    if shares:
        compose_cmd("up", "-d")
    elif not quiet:
        print("No folders left to serve — server stopped.")


def cmd_add(args, config, shares):
    path = Path(args.path).expanduser().resolve()
    if not path.exists():
        die(f"{path} does not exist")
    if not path.is_dir():
        die(f"{path} is not a directory")

    for share in shares:
        if Path(share["path"]) == path:
            die(f"{path} is already served as {share['name']!r}")

    name = args.name or make_name(path.name)
    if not NAME_RE.match(name):
        die("name must start with a letter or digit and use only [a-z0-9._-]")
    if any(share["name"] == name for share in shares):
        die(f"the name {name!r} is taken — pass a different one: ./share add PATH NAME")

    share = {
        "name": name,
        "slug": make_slug(shares),
        "path": str(path),
        "added": date.today().isoformat(),
    }
    shares.append(share)
    save_shares(shares)
    apply(config, shares)
    print(f"\n{name} -> {share_url(config, share)}")


def cmd_rm(args, config, shares):
    share = find_share(shares, args.name)
    shares.remove(share)
    save_shares(shares)
    apply(config, shares)
    print(f"\nRemoved {share['name']} — its URL no longer resolves.")


def cmd_rotate(args, config, shares):
    share = find_share(shares, args.name)
    share["slug"] = make_slug(shares)
    save_shares(shares)
    apply(config, shares)
    print(f"\n{share['name']} -> {share_url(config, share)}")


def cmd_list(args, config, shares):
    if not shares:
        print("No folders are being served. Add one with ./share add PATH")
        return
    width = max(len(share["name"]) for share in shares)
    for share in sorted(shares, key=lambda s: s["name"]):
        print(f"{share['name']:<{width}}  {share_url(config, share)}  {share['path']}")


def cmd_apply(args, config, shares):
    apply(config, shares)


def cmd_up(args, config, shares):
    if not shares:
        die("nothing to serve — add a folder first with ./share add PATH")
    apply(config, shares)


def cmd_down(args, config, shares):
    if not COMPOSE.exists():
        print("Nothing is running.")
        return
    compose_cmd("down", "--remove-orphans")


def cmd_logs(args, config, shares):
    if not COMPOSE.exists():
        die("nothing is running")
    compose_cmd("logs", "-f")


def main():
    parser = argparse.ArgumentParser(
        prog="./share",
        description="Serve local folders over HTTP, each behind its own unguessable URL.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("add", help="serve a folder and print its URL")
    p.add_argument("path", help="folder to serve")
    p.add_argument("name", nargs="?", help="short label (defaults to the folder name)")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rm", help="stop serving a folder")
    p.add_argument("name", help="share name or slug")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("rotate", help="give a folder a new URL and drop the old one")
    p.add_argument("name", help="share name or slug")
    p.set_defaults(func=cmd_rotate)

    sub.add_parser("list", help="show what is being served").set_defaults(func=cmd_list)
    sub.add_parser("apply", help="rebuild config and restart the server").set_defaults(func=cmd_apply)
    sub.add_parser("up", help="start the server").set_defaults(func=cmd_up)
    sub.add_parser("down", help="stop the server").set_defaults(func=cmd_down)
    sub.add_parser("logs", help="follow the server logs").set_defaults(func=cmd_logs)

    args = parser.parse_args()
    args.func(args, load_config(), load_shares())


if __name__ == "__main__":
    main()
