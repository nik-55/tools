# Address to bind on the host. Use 127.0.0.1 to keep the server local-only.
BIND_ADDR=0.0.0.0

# Host port to publish.
PORT=8080

# Base URL used when printing share links.
# Defaults to http://localhost:<PORT> if left empty.
PUBLIC_HOST=

# nginx image to run.
NGINX_IMAGE=nginx:1.27-alpine

# Docker Compose project name.
PROJECT_NAME=serve-folders-over-http
